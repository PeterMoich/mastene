{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "tenant-manager",
    "Audience": "tenant-manager",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "GeneralPerMinute": 300
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "DemoData": false
  },
  "ReverseProxy": {
    "Enabled": false
  }
}
