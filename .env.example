# Copy to .env (which git ignores) and change every value. These are local-only placeholders.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol.
SQL_SA_PASSWORD=Local-Sql-Change-Me-1
# At least 32 random characters, e.g. from:  openssl rand -base64 48
JWT_SIGNING_KEY=local-only-replace-with-32-plus-random-characters
# Password for every synthetic demo login (12+ characters, upper and lower case, a digit).
SEED_PASSWORD=Demo-Password-Change-Me-1
# WhatsApp (optional). Leave these out to use the fake provider, which needs no Meta account.
# To use Meta's Cloud API sandbox, set all five (values from your Meta app, never commit them):
# WHATSAPP_PROVIDER=Meta
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Virus scanning (optional): set to ClamAv and start with  docker compose --profile clamav up --build
# SCANNING_PROVIDER=ClamAv
