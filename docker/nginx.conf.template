# Serves the Angular app and proxies /api to the API container, so the browser only ever
# talks to one origin (no CORS needed). A template: ${API_UPSTREAM} is filled in when the container
# starts (http://api:8080 in docker compose, http://localhost:5080 for the sidecar in Azure App Service).

# Behind Azure's front end TLS ends before nginx, so keep the original scheme it reports.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 6m; # 5 MB uploads (Phase 3) plus multipart overhead

    # img-src blob: lets the app show photos it fetched with the user's token (Phase 4).
    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        # HTTP/1.1 upstream (nginx defaults to 1.0, where Kestrel refuses a bodiless POST without
        # Content-Length) and keep-alive connections to the API.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Hangfire's dashboard (Admin only, signed in by a ticket from the API). It is a server-rendered page
    # with inline scripts, so it gets its own, looser script policy; everything else stays strict.
    location /hangfire {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # Liveness and readiness, for Azure App Service's health check and the compose smoke test.
    location /health/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /swagger {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed bundles can be cached for a long time; index.html never.
    location ~* \.(js|css|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
